# Copy to .env.local and fill in your key.

# Which model serves an analysis, as `provider:model`. Defaults to
# openai:gpt-4o. Only the provider you select needs its API key set.
#   openai:gpt-4o                    openai:gpt-5-mini
#   google:gemini-3.7-flash          google:gemini-3.5-flash-lite
#   anthropic:claude-sonnet-5        anthropic:claude-haiku-4-5-20251001
# Read fresh on every request, and overridable per request with a `model`
# field in the POST body (validated against the same list).
MODEL=openai:gpt-4o

# Provider API keys. Set the one your MODEL uses.
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Legacy: a bare model id, read as an OpenAI model when MODEL is unset.
# OPENAI_MODEL=gpt-4o

# Langfuse tracing — create API keys in your Langfuse project settings.
# Defaults to the EU cloud. Change the URL for another region or self-hosting.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional controls:
LANGFUSE_TRACING_ENVIRONMENT=development
# LANGFUSE_RELEASE=
# LANGFUSE_TRACING_ENABLED=false

# Auth.js — single-user login (no self-registration).
# Generate AUTH_SECRET with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
AUTH_USERNAME=you
AUTH_PASSWORD=change-me
# Needed for self-hosted / non-Vercel deploys.
AUTH_TRUST_HOST=true
